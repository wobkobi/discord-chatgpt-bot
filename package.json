{
  "name": "discord-chatgpt-bot",
  "version": "2.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"fs.rmSync('build',{recursive:true,force:true,maxRetries:10,retryDelay:200});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,md,json,yml,yaml}\"",
    "lint": "eslint --fix --cache \"{src,scripts}/**/*.{js,ts}\"",
    "lint:check": "eslint --max-warnings=0 \"{src,scripts}/**/*.{js,ts}\"",
    "prepare": "simple-git-hooks",
    "smoke": "tsx scripts/smoke-test.ts",
    "start": "npm run build && node build/index.js",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json --noEmit"
  },
  "allowScripts": {
    "esbuild": false,
    "simple-git-hooks": true
  },
  "simple-git-hooks": {
    "pre-commit": "if ! find node_modules/.npm-update-stamp -mmin -1440 2>/dev/null | grep -q .; then npm update --package-lock-only --allow-remote=all --no-audit --no-fund && touch node_modules/.npm-update-stamp; fi && npm install --package-lock-only --allow-remote=all --no-audit --no-fund && git add package-lock.json package.json && npx lint-staged && npm run typecheck",
    "pre-push": "npm run lint && npm run build && npm run smoke"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "**/*.{mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "undici": "^7.18.2",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.8.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "logform": "^2.7.0",
    "luxon": "^3.7.2",
    "mathjax-full": "^3.2.2",
    "openai": "^7.63.0",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.5.4",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "simple-git-hooks": "^2.14.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  }
}
