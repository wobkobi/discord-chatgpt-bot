{
  "name": "chatgpt",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,md,json,yml,yaml}\"",
    "lint": "eslint \"src/**/*.{js,ts}\" --fix",
    "prepare": "simple-git-hooks",
    "start": "tsc && tsc-alias && node build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "npm install --package-lock-only && git add package-lock.json package.json && npx lint-staged && npm run typecheck",
    "pre-push": "npm run lint && npm run build"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "prettier --write",
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "**/*.{mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "undici": "^7.18.2",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@giphy/js-fetch-api": "^5.7.0",
    "discord-api-types": "^0.38.47",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "logform": "^2.7.0",
    "luxon": "^3.7.2",
    "mathjax-full": "^3.2.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.34.0",
    "sanitize-html": "^2.17.3",
    "sharp": "^0.35.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.5.0",
    "lint-staged": "^17.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "simple-git-hooks": "^2.13.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  }
}
